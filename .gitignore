# Abhängigkeiten und Laufzeitdaten (werden beim Docker-Build bzw. Start erzeugt)
/wehrkalender/vendor/
/wehrkalender/.env
/wehrkalender/storage/*
!/wehrkalender/storage/.gitkeep
/wehrkalender/.phpunit.cache
# Erzeugte Dateien
*.pdf
*.aux
*.log
*.out
*.toc
*.zip
/server/logs/
# Einstellungsdateien des Setup-Skripts (enthalten ggf. Zugangsdaten)
/server/*.env
