# =====================================================================
#  Kalenderserver FF KRZ – Konfiguration
#  Kopie als .env anlegen. Die .env gehört NICHT ins Git-Repository.
#  Auf dem Server legt setup-server.sh /srv/kalender/.env an (APP_KEY,
#  DB_PASSWORD, DOMAIN ...). Die Anwendung liest dieselbe Datei.
# =====================================================================

# prod | dev | test
APP_ENV=prod
# 32 Byte, Base64 (head -c 32 /dev/urandom | base64). NIE ändern, sonst sind
# alle gespeicherten Passwörter unlesbar.
APP_KEY=
# Domain des Kalenderservers (setup-server.sh schreibt DOMAIN=..., beides geht)
APP_DOMAIN=kalender.example.de
# Name in Oberfläche und E-Mails
APP_NAME="Kalender FF KRZ"
# Für lokale Tests ohne HTTPS: 0 (sonst setzt der Browser das Sitzungs-Cookie nicht)
SESSION_SECURE=1

# ---------------------------------------------------------------- Datenbank
# mysql (MariaDB) | sqlite
DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=kalender
DB_USER=kalender
DB_PASSWORD=
# nur bei sqlite
DB_PATH=storage/kalender.sqlite

# ---------------------------------------------------------------- E-Mail
# database = nur in der Datenbank ablegen, Vorschau im Admin-Bereich (Testbetrieb)
# smtp     = wirklich verschicken über MAILER_DSN
MAIL_DELIVERY=database
MAILER_DSN=smtp://benutzer:passwort@smtp.example.de:587
MAIL_FROM=kalender@example.de
MAIL_FROM_NAME="Kalender FF KRZ"
# Empfänger für Warnungen (Import, Überwachung), durch Komma getrennt.
# Zusätzlich erhalten alle Benutzer mit Administratorrechten die Warnungen.
ADMIN_ALERT_EMAILS=

# ---------------------------------------------------------------- Netzwerk
# Reverse Proxy (Caddy), dessen X-Forwarded-For vertraut wird (CIDR, Komma)
TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# ---------------------------------------------------------------- Import (noch nicht umgesetzt)
IMPORT_SOURCE=sftp
IMPORT_FORMAT=mpfeuer-json
IMPORT_INBOX=/srv/import/inbox
IMPORT_ARCHIVE=storage/archive
IMPORT_HTTP_MEMBERS_URL=
IMPORT_HTTP_EVENTS_URL=
IMPORT_HTTP_AUTH=bearer
IMPORT_HTTP_TOKEN=
IMPORT_HTTP_INTERVAL=15
