#!/usr/bin/env php
<?php

declare(strict_types=1);

use Kalender\App;
use Kalender\Console;
use Symfony\Component\Console\Application;

require dirname(__DIR__) . '/vendor/autoload.php';

$app = App::boot(dirname(__DIR__));
$console = new Application('Kalenderserver FF KRZ', '1.0');
$console->addCommands([
    new Console\MigrateCommand($app),
    new Console\UserAdminCommand($app),
    new Console\MailSendCommand($app),
    new Console\MonitorCheckCommand($app),
    new Console\CleanupCommand($app),
    new Console\ImportRunCommand($app),
    new Console\TestDataCommand($app),
]);
$console->run();
