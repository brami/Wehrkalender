{% macro run_status(s) %}
  {% set labels = {'success': 'erfolgreich', 'failed': 'fehlgeschlagen', 'aborted': 'abgebrochen', 'running': 'läuft'} %}
  <span class="badge b-{{ s }}">{{ labels[s] ?? s }}</span>
{% endmacro %}

{% macro user_status(s) %}
  <span class="badge b-{{ s }}">{{ s == 'active' ? 'aktiv' : (s == 'locked_email' ? 'gesperrt' : s) }}</span>
{% endmacro %}

{% macro mail_status(s) %}
  {% set labels = {'queued': 'offen', 'sent': 'versendet', 'failed': 'fehlgeschlagen', 'suppressed': 'nicht versendet (Testbetrieb)'} %}
  <span class="badge b-{{ s }}">{{ labels[s] ?? s }}</span>
{% endmacro %}

{% macro mail_type(t) %}
  {% set labels = {'welcome': 'Begrüßung', 'login_link': 'Anmeldelink', 'new_calendar': 'Neue Kalender', 'username_changed': 'Neuer Benutzername', 'admin_alert': 'Warnung an Admins'} %}
  {{ labels[t] ?? t }}
{% endmacro %}

{% macro stats(data) %}
  {% set labels = {
    'members_total': 'Mitglieder im Export', 'users_created': 'neu angelegt', 'users_updated': 'aktualisiert',
    'users_deleted': 'ausgeschieden/gelöscht', 'users_locked': 'gesperrt', 'users_unlocked': 'entsperrt',
    'users_skipped_email': 'ohne gültige Adresse nicht übernommen', 'emails_changed': 'E-Mail geändert',
    'memberships_changed': 'Mitgliedschaften geändert', 'events_total': 'Termine im Export', 'events_added': 'Termine neu',
    'events_modified': 'Termine geändert', 'events_deleted': 'Termine entfernt', 'events_unmapped': 'Termine ohne Kalender',
    'mails_queued': 'E-Mails eingereiht'} %}
  {% for k, v in data %}{% if v is not iterable %}<span class="chip">{{ labels[k] ?? k }}: <b>{{ v }}</b></span> {% endif %}{% endfor %}
{% endmacro %}

{% macro blocked_table(blocked, csrf, back) %}
  <div class="table-wrap"><table>
    <thead><tr><th>Art</th><th>Wer</th><th>Versuche (1 Std.)</th><th>seit</th><th>gesperrt bis</th><th></th></tr></thead>
    <tbody>
    {% for b in blocked %}
      <tr>
        <td>{{ b.label }}</td>
        <td>{% if b.user_id %}<a href="/admin/benutzer/{{ b.user_id }}" class="mono">{{ b.info }}</a>{% else %}<span class="mono">{{ b.info }}</span>{% endif %}</td>
        <td>{{ b.count }} / {{ b.max }}</td>
        <td class="nowrap">{{ b.first|lt('H:i') }}</td>
        <td class="nowrap">{{ b.until|lt('H:i') }}</td>
        <td>
          <form method="post" action="/admin/sperren/aufheben" class="inline">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <input type="hidden" name="key" value="{{ b.key }}">
            <input type="hidden" name="info" value="{{ b.info }}">
            <input type="hidden" name="back" value="{{ back }}">
            <button class="btn btn-secondary btn-small" type="submit">Aufheben</button>
          </form>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
{% endmacro %}
