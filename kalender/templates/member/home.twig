{% extends 'layout.twig' %}
{% block content %}
<h1>Hallo {{ current_user.first_name }}!</h1>

{% if outdated %}
  <div class="notice">
    <h2>Ihr Benutzername passt nicht mehr zu Ihrem Namen</h2>
    <p>Ihr Benutzername <strong class="mono">{{ current_user.username }}</strong> beruht auf einem früheren Namen. Sie können ihn auf <strong class="mono">{{ suggestion }}</strong> umstellen – müssen es aber nicht. Alles funktioniert auch mit dem bisherigen Benutzernamen weiter.</p>
    <a class="btn btn-secondary" href="/konto/benutzername">Benutzername umstellen …</a>
  </div>
{% endif %}

<h2>Meine Kalender</h2>
{% if calendars is empty %}
  <div class="box">
    <p>Ihnen ist derzeit kein Kalender zugeordnet. Welche Kalender Sie sehen, ergibt sich aus Ihren Mitgliedschaften in MP Feuer.</p>
    {% if unmapped is not empty %}<p class="muted small">Ihre Mitgliedschaften laut MP Feuer: {{ unmapped|join(', ') }}</p>{% endif %}
  </div>
{% else %}
  <p class="muted">Diese Kalender sind für Sie freigeschaltet. Sie ergeben sich aus Ihren Mitgliedschaften in MP Feuer.</p>
  <div class="box">
    <ul class="cal-list">
    {% for c in calendars %}
      <li>
        <span class="swatch" style="background: {{ c.color }}"></span>
        <span class="cal-name">
          <strong>{{ c.display_name }}</strong>
          {% if c.description %}<span class="muted small">{{ c.description }}</span>{% endif %}
          <span class="muted small cal-origin">
            {%- if c.all_members %}für alle Mitglieder{% if c.origins is not empty %} · {% endif %}{% endif -%}
            {%- if c.origins is not empty %}aus: {{ c.origins|join(', ') }}{% endif -%}
          </span>
        </span>
        <span class="cal-count">{{ c.event_count }} {{ c.event_count == 1 ? 'Termin' : 'Termine' }} in {{ year }}</span>
      </li>
    {% endfor %}
    </ul>
    {% if unmapped is not empty %}
      <p class="small muted" style="margin:.75rem 0 0">Weitere Mitgliedschaften laut MP Feuer ohne eigenen Kalender: {{ unmapped|join(', ') }}</p>
    {% endif %}
  </div>
  <p class="small muted">Fehlt ein Kalender oder stimmt eine Mitgliedschaft nicht, muss das in MP Feuer geändert werden. Nach dem nächsten Abgleich passt sich alles automatisch an.</p>

  <div class="box callout">
    <h2 style="margin-top:0">So kommen die Termine auf Ihr Gerät</h2>
    <p>Richten Sie die Kalender einmalig auf Ihrem Smartphone, Tablet oder in Outlook ein. Danach werden die Termine automatisch aktuell gehalten.</p>
    <a class="btn" href="/abonnieren">Kalender abonnieren</a>
    <a class="btn btn-secondary" href="/terminuebersicht">Terminübersicht als PDF</a>
  </div>
{% endif %}
{% endblock %}
