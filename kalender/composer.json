{
    "name": "ff-krz/kalender",
    "description": "Kalenderserver der FF KRZ: Termine aus MP Feuer per CalDAV und iCalendar-Abo, nur lesend",
    "type": "project",
    "license": "proprietary",
    "require": {
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "php": ">=8.3",
        "sabre/dav": "^4.7",
        "sabre/vobject": "^4.5",
        "setasign/fpdf": "^1.8",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "symfony/console": "^7.1",
        "symfony/http-client": "^7.1",
        "symfony/mailer": "^7.1",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-idn": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php83": "*"
    },
    "autoload": {
        "psr-4": {
            "Kalender\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kalender\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
