{% extends 'layout.twig' %}
{% import 'admin/_macros.twig' as m %}
{% block title %}E-Mail – {{ app_name }}{% endblock %}
{% block content %}
<p class="small"><a href="/admin/mails">← Alle E-Mails</a></p>
<h1>{{ mail.subject }}</h1>
<div class="box">
  <dl class="facts">
    <dt>Typ</dt><dd>{{ m.mail_type(mail.type) }}</dd>
    <dt>An</dt><dd class="mono">{{ mail.recipient }}{% if mail.user_id %} (<a href="/admin/benutzer/{{ mail.user_id }}">{{ mail.username }}</a>){% endif %}</dd>
    <dt>Status</dt><dd>{{ m.mail_status(mail.status) }} · {{ mail.attempts }} Versuch(e){% if mail.sent_at %} · versendet {{ mail.sent_at|lt }}{% endif %}</dd>
    <dt>Erstellt</dt><dd>{{ mail.created_at|lt }}</dd>
    {% if mail.last_error %}<dt>Fehler</dt><dd class="warn">{{ mail.last_error }}</dd>{% endif %}
  </dl>
  <div class="actions">
    <a class="btn btn-secondary btn-small" href="/admin/mails/{{ mail.id }}/html" target="_blank" rel="noopener">HTML-Fassung ansehen</a>
    {% if mail.status in ['failed', 'suppressed', 'queued'] %}
      <form method="post" action="/admin/mails/{{ mail.id }}/erneut" class="inline">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <button class="btn btn-secondary btn-small" type="submit">Erneut senden</button>
      </form>
    {% endif %}
  </div>
</div>
<h2>Textfassung</h2>
<pre class="mail">{{ mail.body_text }}</pre>
<p class="small muted">Hinweis: Enthaltene Anmelde- und Abo-Links sind echt und funktionieren.</p>
{% endblock %}
