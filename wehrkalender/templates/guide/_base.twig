{% extends 'layout.twig' %}
{% block title %}Anleitung {{ guides[guide] }} – {{ app_name }}{% endblock %}
{% block content %}
<nav class="subnav" aria-label="Anleitungen">
  {% for key, label in guides %}
    <a href="/anleitung/{{ key }}" {% if key == guide %}aria-current="page"{% endif %}>{{ label }}</a>
  {% endfor %}
</nav>
<h1>{% block heading %}{% endblock %}</h1>
<p class="muted small">Bebilderte Fassung folgt nach Inbetriebnahme des Servers. Die Kalender sind nur lesbar: Termine werden in MP Feuer bzw. bei der jeweiligen Quelle gepflegt.</p>
{% if current_user %}
  <div class="box small">
    <strong>Ihre Daten:</strong> Server <code>{{ domain }}</code> · Benutzername <code>{{ current_user.username }}</code> ·
    Passwort und Abo-Links finden Sie unter <a href="/abonnieren">Kalender abonnieren</a>.
  </div>
{% else %}
  <div class="box small">Ihre Zugangsdaten sehen Sie nach der <a href="/login">Anmeldung</a>. Den ersten Anmeldelink erhalten Sie per Begrüßungs-E-Mail oder über <a href="/login/link">Anmeldelink anfordern</a>.</div>
{% endif %}
{% block guide %}{% endblock %}
{% endblock %}
