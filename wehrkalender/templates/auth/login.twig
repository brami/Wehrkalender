{% extends 'layout.twig' %}
{% block title %}Anmelden – {{ app_name }}{% endblock %}
{% block content %}
<div class="narrow">
  <h1>Anmelden</h1>
  <p class="muted">Hier sehen Sie Ihre Kalender der {{ wehr_name }}, die Abo-Links für Outlook und die Zugangsdaten für Smartphone und Tablet.</p>

  {% if locked is defined and locked %}
    <div class="flash flash-error" role="alert">
      Ihr Zugang ist derzeit gesperrt, weil die in MP Feuer hinterlegte E-Mail-Adresse ungültig ist.
      Bitte lassen Sie die Adresse in MP Feuer korrigieren. Nach dem nächsten Import ist der Zugang
      automatisch wieder aktiv; Benutzername, Passwort und Abo-Links bleiben erhalten.
    </div>
  {% endif %}
  {% if error is defined %}<div class="flash flash-error" role="alert">{{ error }}</div>{% endif %}

  <form method="post" action="/login" class="box">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <label for="identity">Benutzername oder E-Mail-Adresse</label>
    <input type="text" id="identity" name="identity" value="{{ identity }}" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
    <label for="password">Passwort</label>
    <input type="password" id="password" name="password" autocomplete="current-password" required>
    <div class="actions"><button class="btn" type="submit">Anmelden</button></div>
  </form>

  <div class="box">
    <h2 style="margin-top:0">Passwort vergessen oder noch nie angemeldet?</h2>
    <p>Lassen Sie sich einen Anmeldelink an Ihre in MP Feuer hinterlegte E-Mail-Adresse schicken. Nach der Anmeldung wird Ihr Passwort angezeigt.</p>
    <a class="btn btn-secondary" href="/login/link">Anmeldelink anfordern</a>
  </div>
</div>
{% endblock %}
