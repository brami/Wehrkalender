# Wehrkalender – Caddyfile (Ablage: /srv/wehrkalender/caddy/Caddyfile)
{
	# Kontakt-E-Mail nur, wenn in .env gesetzt (siehe setup-server-wehrkalender.sh)
	# email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

(sicherheit) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
		-X-Powered-By
	}
}

# Zugriffsprotokoll: Abo-Tokens und Einmal-Links maskiert, IP-Adressen gekürzt,
# Anmeldedaten und Cookies entfernt; 14 Tage aufbewahrt
(protokoll) {
	log {
		output file /var/log/caddy/access.log {
			roll_keep_for 336h
		}
		format filter {
			request>uri regexp "^/(abo|login/link)/[^/?]+" "/$1/***"
			request>remote_ip ip_mask 16 32
			request>client_ip ip_mask 16 32
			request>headers>Authorization delete
			request>headers>Cookie delete
			resp_headers>Set-Cookie delete
		}
	}
}

{$DOMAIN} {
	import sicherheit
	import protokoll

	# automatische Erkennung für Kalender-Apps
	redir /.well-known/caldav /dav/ 301

	root * /srv/app/public
	@static path /assets/*
	handle @static {
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle {
		# alle anderen Anfragen (inkl. WebDAV-Methoden wie PROPFIND) an PHP
		php_fastcgi app:9000 {
			root /srv/app/public
			try_files {path} /index.php
		}
	}
}

