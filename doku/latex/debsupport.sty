% =====================================================================
%  debsupport.sty  --  Corporate Design deb-support fuer LaTeX
%  Abgeleitet aus der Rechnungsvorlage RE490022 (28.03.2025)
%
%  Paketoptionen:
%    brief    -> wird automatisch von debsupport.lco gesetzt
%    bericht  -> Seitenlayout fuer Berichte/Protokolle (scrartcl/scrreprt)
%    aushang  -> Seitenlayout fuer Aushaenge (scrartcl)
%
%  Firmendaten aendern:  \dssetup{telefon=..., iban=..., ...}
%  Engine: pdfLaTeX (lualatex/xelatex funktionieren ebenfalls)
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{debsupport}[2026/11/07 v1.0 Corporate Design deb-support]

\newif\ifds@brief
\newif\ifds@bericht
\newif\ifds@aushang
\DeclareOption{brief}{\ds@brieftrue}
\DeclareOption{bericht}{\ds@berichttrue}
\DeclareOption{aushang}{\ds@aushangtrue}
\ProcessOptions\relax

% ---------------------------------------------------------------------
%  Schriften & Sprache
%  Fliesstext: Helvetica (wie Vorlage), Kopf/Fuss: Computer Modern
% ---------------------------------------------------------------------
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage{lmodern}
  \RequirePackage[scaled=1]{helvet}
\else
  \RequirePackage{fontspec}
  \setmainfont{Latin Modern Roman}
  \IfFontExistsTF{TeX Gyre Heros}
    {\setsansfont{TeX Gyre Heros}}{\setsansfont{Latin Modern Sans}}
\fi
\renewcommand*{\familydefault}{\sfdefault}
\IfFileExists{ngerman.ldf}
  {\RequirePackage[ngerman]{babel}}
  {\RequirePackage[ngerman,provide=*]{babel}}
\RequirePackage{microtype}

\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{array,booktabs,longtable,tabularx}
\RequirePackage{enumitem}
\RequirePackage{siunitx}
\RequirePackage{eso-pic}
\RequirePackage[skins,breakable]{tcolorbox}
\RequirePackage{scrlayer-scrpage}
\ifds@brief\else\RequirePackage{lastpage}\fi

% ---------------------------------------------------------------------
%  Farben
% ---------------------------------------------------------------------
\definecolor{dsrot}{RGB}{255,0,0}     % Logofarbe
\definecolor{dsgrau}{gray}{0.40}      % Nebeninformationen
\definecolor{dshell}{gray}{0.93}      % Hinterlegungen

% ---------------------------------------------------------------------
%  Firmendaten (Schluessel fuer \dssetup)
% ---------------------------------------------------------------------
\ExplSyntaxOn
\keys_define:nn { debsupport }
  {
    firma     .tl_gset:N = \dsFirma ,
    inhaber   .tl_gset:N = \dsInhaber ,
    strasse   .tl_gset:N = \dsStrasse ,
    plz       .tl_gset:N = \dsPLZ ,
    ort       .tl_gset:N = \dsOrt ,
    land      .tl_gset:N = \dsLand ,
    telefon   .tl_gset:N = \dsTelefon ,
    email     .tl_gset:N = \dsEmail ,
    web       .tl_gset:N = \dsWeb ,
    steuernr  .tl_gset:N = \dsSteuernr ,
    ustid     .tl_gset:N = \dsUStId ,
    bank      .tl_gset:N = \dsBank ,
    bic       .tl_gset:N = \dsBIC ,
    iban      .tl_gset:N = \dsIBAN ,
  }
\NewDocumentCommand \dssetup { m } { \keys_set:nn { debsupport } {#1} }
\ExplSyntaxOff

\dssetup{
